{
  "manifest_version": 3,
  "name": "SipPulse Meet Capture",
  "version": "0.3.0",
  "description": "Live Google Meet transcription, notes, and meeting reports delivered to SipPulse CRM.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "identity",
    "identity.email",
    "offscreen",
    "sidePanel",
    "tabCapture"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/lib/logger.js",
        "src/lib/config.js",
        "src/lib/selectors.js",
        "src/lib/storage.js",
        "src/lib/vcon.js",
        "src/lib/captions.js",
        "src/lib/transcription.js",
        "src/content/captions-watchdog.js",
        "src/content/active-speaker.js",
        "src/content/transcript-capture.js",
        "src/content/panel-bridge.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "storage": {
    "managed_schema": "enterprise-policy.json"
  },
  "action": {
    "default_title": "SipPulse Meet Capture",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
