{
  "manifest_version": 3,
  "name": "SipPulse Meet Capture",
  "version": "0.2.0",
  "description": "Securely deliver Google Meet captions to SipPulse for your organization.",
  "minimum_chrome_version": "120",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "identity",
    "identity.email",
    "offscreen",
    "tabCapture"
  ],

  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.sippulse.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "src/lib/logger.js",
        "src/lib/config.js",
        "src/lib/selectors.js",
        "src/lib/storage.js",
        "src/lib/vcon.js",
        "src/lib/captions.js",
        "src/content/captions-watchdog.js",
        "src/content/transcript-capture.js",
        "src/content/in-call-panel.js",
        "src/content/main.js"
      ],
      "css": ["src/content/panel.css"],
      "run_at": "document_idle"
    }
  ],

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "storage": {
    "managed_schema": "enterprise-policy.json"
  },

  "action": {
    "default_title": "SipPulse Meet Capture",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
